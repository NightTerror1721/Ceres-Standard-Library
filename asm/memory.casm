// memory.casm - the hot memory primitives. Leaf routines: no frame, r0-r7 only.
//
// Each is one of the machine's block instructions (CeresASM 6b6372b): mcpy, mset, mcmp and mscan do a whole
// memcpy, memset, memcmp or memchr, a page per step, with the MMU, the protection of .text and the device
// window all checked as a byte access would be. They cost the clock 1 + bytes/16 ticks a page, where the
// word loops these replaced measured 0.5 to 1.6 instructions per byte (memcpy of 4 KiB: 3300 before, 257
// now). memmove with the destination above an overlapping source copies from the top down in pieces no
// longer than the gap between them, which do not overlap; a gap under 16 bytes goes back to a word and
// byte loop, since pieces that short would cost more than it.
@text

// void* memcpy(void* dst, const void* src, size_t n)   r0 = dst, r1 = src, r2 = n
global memcpy:
    mov  r4, r0                 // the return value
    mcpy r0, r1, r2
    mov  r0, r4
    ret

// void* memmove(void* dst, const void* src, size_t n)
global memmove:
    ifbe r0, r1, memcpy         // dst <= src: a forward copy is safe (tail call)
    add  r4, r1, r2             // src + n
    ifae r0, r4, memcpy         // dst >= src + n: no overlap
    mov  r4, r0                 // the return value
    sub  r5, r0, r1             // the gap, 0 < gap < n
    ifbl r5, 16, .mvsmall
.mvpiece:                       // the top piece of what is left: [dst + left - k, dst + left) from src the same
    ifeq r2, 0, .mvdone
    min  r6, r2, r5             // k = min(left, gap): source and destination of a piece never overlap
    sub  r2, r2, r6
    add  r3, r4, r2
    add  r7, r1, r2
    mcpy r3, r7, r6
    jp   .mvpiece
.mvsmall:                       // a gap under 16: backwards from the ends, words when co-aligned
    add  r0, r0, r2
    add  r1, r1, r2
    xor  r5, r0, r1
    and  r5, r5, 3
    ifne r5, 0, .mvtail
.mvhead:
    and  r5, r0, 3
    ifeq r5, 0, .mvw4
    ifeq r2, 0, .mvdone
    sub  r0, r0, 1
    sub  r1, r1, 1
    ldrb r6, [r1]
    strb [r0], r6
    sub  r2, r2, 1
    jp   .mvhead
.mvw4:
    ifbl r2, 4, .mvtail
.mvw4loop:
    sub  r0, r0, 4
    sub  r1, r1, 4
    ldr  r6, [r1]
    str  [r0], r6
    sub  r2, r2, 4
    ifae r2, 4, .mvw4loop
.mvtail:
    ifeq r2, 0, .mvdone
.mvtailloop:
    sub  r0, r0, 1
    sub  r1, r1, 1
    ldrb r6, [r1]
    strb [r0], r6
    sub  r2, r2, 1
    ifne r2, 0, .mvtailloop
.mvdone:
    mov  r0, r4
    ret

// void* memset(void* dst, int c, size_t n)   (the low byte of c)
global memset:
    mov  r4, r0
    mset r0, r1, r2
    mov  r0, r4
    ret

// int memcmp(const void* a, const void* b, size_t n)
// The difference of the first pair of bytes that differ, as unsigned bytes. mcmp leaves both pointers at
// that pair and the count at what is left from it, or 0 when there is none.
global memcmp:
    mcmp r0, r1, r2
    ifeq r2, 0, .mcequal
    ldrb r4, [r0]
    ldrb r5, [r1]
    sub  r0, r4, r5
    ret
.mcequal:
    li   r0, 0
    ret

// size_t strlen(const char* s)
// One scan for the zero byte, with no limit of its own.
global strlen:
    mov  r1, r0
    li   r2, 0
    la   r3, 0xFFFFFFFF
    mscan r1, r2, r3            // r1 = the terminator
    sub  r0, r1, r0
    ret

// void memset32(unsigned int* dst, unsigned int value, size_t count)   -- count in WORDS
global memset32:
.m32:
    ifeq r2, 0, .m32done
    str  [r0], r1
    add  r0, r0, 4
    sub  r2, r2, 1
    jp   .m32
.m32done:
    ret
