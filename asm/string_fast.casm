// string_fast.casm - string routines written for speed: strcpy, strcmp, strchr and memchr (strlen and the memory
// primitives are in memory.casm already). They are OPTIONAL: they have their own names, and ceres/string_fast.h
// maps the standard ones onto them for a program that asks. Leaf routines: no frame, r0-r7.
//
// Each reads a word at a time while its pointers are aligned and the word shows nothing to stop for, and a byte
// at a time otherwise (unaligned pointers, the word that holds the end or the difference, the last bytes). A
// word is tested for a zero byte with ((w - 0x01010101) & ~w & 0x80808080), which is non-zero exactly when
// one byte of w is zero; a word is tested for a byte c by xoring it with c repeated four times first.
//
// Measured on 4096 bytes, in instructions (the timer's ticks, the same on every run), against the C versions
// at -O2: strcpy 11305 vs 32797, strcmp 13356 vs 40995, strchr 15407 vs 45089, memchr 13347 vs 36896 - about a
// third. At -O0 the C versions take ten times what they do at -O2 (strcpy 327801), and these do not change.
@text

// char* strcpy_fast(char* dst, const char* src)   r0 = dst, r1 = src
global strcpy_fast:
    mov  r4, r0                 // the return value
    or   r5, r0, r1
    and  r5, r5, 3
    ifne r5, 0, .cpbytes        // either pointer unaligned: bytes only
    la   r6, 0x01010101
    la   r7, 0x80808080
.cpwords:
    ldr  r2, [r1]
    sub  r3, r2, r6
    not  r5, r2
    and  r3, r3, r5
    and  r3, r3, r7             // non-zero when the word holds the terminator
    ifne r3, 0, .cpbytes        // finish it a byte at a time
    str  [r0], r2
    add  r0, r0, 4
    add  r1, r1, 4
    jp   .cpwords
.cpbytes:
    ldrb r2, [r1]
    strb [r0], r2
    add  r0, r0, 1
    add  r1, r1, 1
    ifne r2, 0, .cpbytes
    mov  r0, r4
    ret

// int strcmp_fast(const char* a, const char* b)   r0 = a, r1 = b
// Returns the difference of the first pair of bytes that differ, as unsigned bytes, exactly as strcmp does.
global strcmp_fast:
    or   r4, r0, r1
    and  r4, r4, 3
    ifne r4, 0, .cmloop         // either pointer unaligned: bytes only
    la   r6, 0x01010101
    la   r7, 0x80808080
.cmwords:
    ldr  r2, [r0]
    ldr  r3, [r1]
    ifne r2, r3, .cmloop        // the words differ: the bytes say where
    sub  r4, r2, r6
    not  r5, r2
    and  r4, r4, r5
    and  r4, r4, r7
    ifne r4, 0, .cmloop         // equal, and the terminator is in them: the bytes will return 0
    add  r0, r0, 4
    add  r1, r1, 4
    jp   .cmwords
.cmloop:
    ldrb r2, [r0]
    ldrb r3, [r1]
    ifne r2, r3, .cmdiff
    ifeq r2, 0, .cmequal
    add  r0, r0, 1
    add  r1, r1, 1
    jp   .cmloop
.cmequal:
    li   r0, 0
    ret
.cmdiff:
    sub  r0, r2, r3
    ret

// char* strchr_fast(const char* s, int c)   r0 = s, r1 = c
// The first occurrence of (char)c, which for c == 0 is the terminator; NULL when there is none.
global strchr_fast:
    and  r1, r1, 255
    and  r4, r0, 3
    ifne r4, 0, .scloop         // unaligned: bytes only
    la   r5, 0x01010101
    mul  r6, r1, r5             // c repeated in all four bytes
    la   r7, 0x80808080
.scwords:
    ldr  r3, [r0]
    sub  r2, r3, r5
    not  r4, r3
    and  r2, r2, r4
    and  r2, r2, r7             // a terminator in the word
    xor  r4, r3, r6             // a byte equal to c is now zero
    sub  r3, r4, r5
    not  r4, r4
    and  r3, r3, r4
    and  r3, r3, r7             // a c in the word
    or   r2, r2, r3
    ifne r2, 0, .scloop         // one or the other: find which, a byte at a time
    add  r0, r0, 4
    jp   .scwords
.scloop:
    ldrb r2, [r0]
    ifeq r2, r1, .scfound
    ifeq r2, 0, .scnone
    add  r0, r0, 1
    jp   .scloop
.scfound:
    ret                         // r0 already points at it
.scnone:
    li   r0, 0
    ret

// void* memchr_fast(const void* p, int c, size_t n)   r0 = p, r1 = c, r2 = n
global memchr_fast:
    and  r1, r1, 255
    and  r4, r0, 3
    ifne r4, 0, .mcloop         // unaligned: bytes only
    la   r5, 0x01010101
    mul  r6, r1, r5             // c repeated in all four bytes
    la   r7, 0x80808080
.mcwords:
    ifbl r2, 4, .mcloop         // fewer than four bytes left
    ldr  r3, [r0]
    xor  r3, r3, r6             // a byte equal to c is now zero
    sub  r4, r3, r5
    not  r3, r3
    and  r4, r4, r3
    and  r4, r4, r7             // a c in the word
    ifne r4, 0, .mcloop         // find it a byte at a time
    add  r0, r0, 4
    sub  r2, r2, 4
    jp   .mcwords
.mcloop:
    ifeq r2, 0, .mcnone
    ldrb r3, [r0]
    ifeq r3, r1, .mcfound
    add  r0, r0, 1
    sub  r2, r2, 1
    jp   .mcloop
.mcfound:
    ret
.mcnone:
    li   r0, 0
    ret
