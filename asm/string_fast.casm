// string_fast.casm - strcpy, strcmp, strchr and memchr, written for speed (strlen and the memory primitives
// are in memory.casm). These ARE the standard functions: each has its standard name and, for code written
// against ceres/string_fast.h, its old _fast name at the same address. Leaf routines: no frame, r0-r7.
//
// Each is built on the machine's block instructions (CeresASM 6b6372b): an mscan for the terminator gives
// the string's length, and one more mcpy, mcmp or mscan does the rest, a page per step. The word loops these
// replaced took about a third of what the byte loops in C did; these take a few steps per page.
@text

// char* strcpy(char* dst, const char* src)   r0 = dst, r1 = src
global strcpy:
global strcpy_fast:
    mov  r4, r0                 // the return value
    mov  r5, r1
    li   r6, 0
    la   r7, 0xFFFFFFFF
    mscan r5, r6, r7            // r5 = src's terminator
    sub  r6, r5, r1
    add  r6, r6, 1              // the bytes to copy, the terminator with them
    mcpy r0, r1, r6
    mov  r0, r4
    ret

// int strcmp(const char* a, const char* b)   r0 = a, r1 = b
// Returns the difference of the first pair of bytes that differ, as unsigned bytes, as C's strcmp does.
// Comparing a's bytes and its terminator is enough: b cannot match past its own terminator, so the first
// difference comes at or before it, and nothing past it is read.
global strcmp:
global strcmp_fast:
    mov  r5, r0
    li   r6, 0
    la   r7, 0xFFFFFFFF
    mscan r5, r6, r7            // r5 = a's terminator
    sub  r6, r5, r0
    add  r6, r6, 1
    mcmp r0, r1, r6
    ifeq r6, 0, .cmequal
    ldrb r2, [r0]
    ldrb r3, [r1]
    sub  r0, r2, r3
    ret
.cmequal:
    li   r0, 0
    ret

// char* strchr(const char* s, int c)   r0 = s, r1 = c
// The first occurrence of (char)c, which for c == 0 is the terminator; NULL when there is none. The string's
// length first, then c among its bytes and its terminator.
global strchr:
global strchr_fast:
    mov  r5, r0
    li   r6, 0
    la   r7, 0xFFFFFFFF
    mscan r5, r6, r7            // r5 = the terminator
    sub  r6, r5, r0
    add  r6, r6, 1
    mscan r0, r1, r6            // the low byte of c
    ifeq r6, 0, .scnone
    ret                         // r0 points at it
.scnone:
    li   r0, 0
    ret

// void* memchr(const void* p, int c, size_t n)   r0 = p, r1 = c, r2 = n
global memchr:
global memchr_fast:
    mscan r0, r1, r2            // the low byte of c
    ifeq r2, 0, .mcnone
    ret                         // r0 points at it
.mcnone:
    li   r0, 0
    ret
