@text

global fabs:
    abs f0, f0
    ret

global fmod:
    mod f0, f0, f1
    ret

global sqrt:
    sqrt f0, f0
    ret

global floor:
    ffloor f0, f0
    ret

global ceil:
    fceil f0, f0
    ret

global round:
    fround f0, f0
    ret

global trunc:
    ftrunc f0, f0
    ret

global fmin:
    fmin f0, f0, f1
    ret

global fmax:
    fmax f0, f0, f1
    ret

global copysign:
    fcopysign f0, f0, f1
    ret

global fma:
    fma f0, f1, f2
    ret

global rcp:
    frecipe f0, f0
    ret

global rsqrt:
    frsqrte f0, f0
    ret

// ---- classification and bit access ----
// `fclass rd, fs` sets exactly one bit: 0 -inf, 1 -normal, 2 -subnormal, 3 -0, 4 +0,
// 5 +subnormal, 6 +normal, 7 +inf, 8 NaN.

global isnan:
    fclass r0, f0
    shr    r0, r0, 8            // bit 8
    ret

global isinf:                   // bits 0 (-inf) and 7 (+inf)
    fclass r1, f0
    and    r0, r1, 129
    ifeq   r0, 0, .not_inf
    li     r0, 1
.not_inf:
    ret

global signbit:                 // -inf, -normal, -subnormal, -0 = bits 0..3
    fclass r1, f0
    and    r0, r1, 15
    ifeq   r0, 0, .positive
    li     r0, 1
.positive:
    ret

global float_bits:
    mff r0, f0
    ret

global float_from_bits:
    mtf f0, r0
    ret
