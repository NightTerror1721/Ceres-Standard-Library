{
    "configurations": [
        {
            "name": "Ceres",
            "includePath": [
                "${workspaceFolder}/include",
                "${workspaceFolder}/src",
                "${workspaceFolder}/**"
            ],
            "defines": [
                "__interrupt=",
                "__interrupt_vector(int_num, isr)=",
                "__builtin_sti()=",
                "__builtin_cli()=",
                "__builtin_halt()=",
                "__builtin_va_list=void*",
                "__builtin_va_start(ap, last)=",
                "__builtin_va_arg(ap, T)=(*(T*)0)",
                "__builtin_va_end(ap)=",
                "__builtin_va_copy(dest, src)="
            ],
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-x64"
        }
    ],
    "version": 4
}
