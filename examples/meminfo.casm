    str [sp + __frame_show_heap.slot4], r5 // examples/meminfo.c:17
    call sys_stack_free   // examples/meminfo.c:17
    mov r7, r0            // examples/meminfo.c:17
    ldr r4, [sp + __frame_show_heap.slot1] // examples/meminfo.c:16
    mov r0, r4            // examples/meminfo.c:16
    ldr r4, [sp + __frame_show_heap.slot2] // examples/meminfo.c:16
